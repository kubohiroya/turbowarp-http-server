{
  "schemaVersion": 2,
  "manifestFormatVersion": 2,
  "dataReference": {"kind": "named", "scope": "target", "lifetime": "untilProjectStop"},
  "serverUnsupportedOpcodes": ["copyDocumentTree"],
  "cases": [
    {"name": "parse canonical JSON", "format": "json", "text": "{\"z\":0,\"a\":{\"d\":4,\"b\":2}}", "dataName": "document", "expectedJson": "{\"a\":{\"b\":2,\"d\":4},\"z\":0}"},
    {"name": "parse YAML", "format": "yaml", "text": "name: sensor\nenabled: true", "dataName": "document", "expectedJson": "{\"enabled\":true,\"name\":\"sensor\"}"},
    {"name": "typed path update", "format": "json", "text": "{\"users\":[{\"name\":\"Ada\"}]}", "dataName": "document", "path": "$.users[0].name", "normalizedPath": [{"kind": "key", "value": "users"}, {"kind": "index", "value": 0}, {"kind": "key", "value": "name"}], "setJson": "\"Grace\"", "expectedJson": "{\"users\":[{\"name\":\"Grace\"}]}"},
    {"name": "invalid YAML", "format": "yaml", "text": "base: &x [1]\ncopy: *x", "dataName": "document", "error": "INVALID_YAML"}
  ],
  "readCases": [
    {"name": "JSON get keeps quotes on a string", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.get", "path": "$.name", "expectedJson": "\"Apple\""},
    {"name": "text of a string has no JSON quotes", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.name", "expectedText": "Apple"},
    {"name": "text of a string keeps quotes inside it unescaped", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.quoted", "expectedText": "say \"hi\""},
    {"name": "text of an empty string is empty", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.empty", "expectedText": ""},
    {"name": "text of a number is its canonical JSON text", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.count", "expectedText": "1.5"},
    {"name": "text of a boolean is its JSON text", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.ok", "expectedText": "true"},
    {"name": "text from YAML reads the same value", "format": "yaml", "text": "name: Apple\ncount: 3", "dataName": "document", "operation": "structuredData.getText", "path": "$.count", "expectedText": "3"},
    {"name": "text of null is a type mismatch", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.none", "error": "TYPE_MISMATCH"},
    {"name": "text of an array is a type mismatch", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.list", "error": "TYPE_MISMATCH"},
    {"name": "text of an object is a type mismatch", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.nested", "error": "TYPE_MISMATCH"},
    {"name": "text with an invalid name", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "readName": " ", "path": "$.name", "error": "INVALID_NAME"},
    {"name": "text from missing data", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "readName": "missing", "path": "$.name", "error": "DATA_NOT_FOUND"},
    {"name": "text with an invalid path", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$..name", "error": "INVALID_PATH"},
    {"name": "text at a missing key", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.missing", "error": "PATH_NOT_FOUND"},
    {"name": "text through a non-container", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.name.first", "error": "TYPE_MISMATCH"},
    {"name": "text past the end of an array", "format": "json", "text": "{\"name\":\"Apple\",\"quoted\":\"say \\\"hi\\\"\",\"empty\":\"\",\"count\":1.50,\"ok\":true,\"none\":null,\"list\":[1],\"nested\":{\"a\":1}}", "dataName": "document", "operation": "structuredData.getText", "path": "$.list[1]", "error": "INDEX_OUT_OF_RANGE"},
    {"name": "current value JSON of an entry", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentValue", "path": "$", "expectedJson": "{\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"],\"type\":\"heading\"}"},
    {"name": "current value at the root path equals current value JSON", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "$", "expectedJson": "{\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"],\"type\":\"heading\"}"},
    {"name": "current value at a path is JSON", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "$.type", "expectedJson": "\"heading\""},
    {"name": "current value at a null path is JSON null", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "$.meta", "expectedJson": "null"},
    {"name": "current value follows the active entry", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 1}], "operation": "structuredData.currentGet", "path": "$", "expectedJson": "{\"depth\":2,\"type\":\"paragraph\"}"},
    {"name": "current value reads the innermost nested entry", "format": "json", "text": "{\"groups\":[{\"name\":\"fruit\",\"items\":[\"apple\",\"banana\"]}]}", "dataName": "document", "loops": [{"path": "$.groups", "entry": 0}, {"path": "$.groups[0].items", "entry": 1}], "operation": "structuredData.currentGet", "path": "$", "expectedJson": "\"banana\""},
    {"name": "current value outside iteration", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "operation": "structuredData.currentGet", "path": "$", "error": "ITERATION_CONTEXT_REQUIRED"},
    {"name": "current value outside iteration checks the loop before the path", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "operation": "structuredData.currentGet", "path": "$..bad", "error": "ITERATION_CONTEXT_REQUIRED"},
    {"name": "current value with an invalid path", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "type", "error": "INVALID_PATH"},
    {"name": "current value at a missing key", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 1}], "operation": "structuredData.currentGet", "path": "$.tags", "error": "PATH_NOT_FOUND"},
    {"name": "current value through a non-container", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "$.type.name", "error": "TYPE_MISMATCH"},
    {"name": "current value past the end of an array", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGet", "path": "$.tags[1]", "error": "INDEX_OUT_OF_RANGE"},
    {"name": "current text of a string has no JSON quotes", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.type", "expectedText": "heading"},
    {"name": "current text of a key list entry is a plain key", "format": "json", "text": "[\"apple\",\"banana\"]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$", "expectedText": "apple"},
    {"name": "current text of a number is its JSON text", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.depth", "expectedText": "1"},
    {"name": "current text of a boolean is its JSON text", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.done", "expectedText": "false"},
    {"name": "current text reads the innermost nested entry", "format": "json", "text": "{\"groups\":[{\"name\":\"fruit\",\"items\":[\"apple\",\"banana\"]}]}", "dataName": "document", "loops": [{"path": "$.groups", "entry": 0}, {"path": "$.groups[0].items", "entry": 1}], "operation": "structuredData.currentGetText", "path": "$", "expectedText": "banana"},
    {"name": "current text reads an outer entry before the inner loop starts", "format": "json", "text": "{\"groups\":[{\"name\":\"fruit\",\"items\":[\"apple\",\"banana\"]}]}", "dataName": "document", "loops": [{"path": "$.groups", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.name", "expectedText": "fruit"},
    {"name": "current text of null is a type mismatch", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.meta", "error": "TYPE_MISMATCH"},
    {"name": "current text of an array is a type mismatch", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.tags", "error": "TYPE_MISMATCH"},
    {"name": "current text of an object is a type mismatch", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$", "error": "TYPE_MISMATCH"},
    {"name": "current text outside iteration", "format": "json", "text": "[\"apple\",\"banana\"]", "dataName": "document", "operation": "structuredData.currentGetText", "path": "$", "error": "ITERATION_CONTEXT_REQUIRED"},
    {"name": "current text with an invalid path", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$[01]", "error": "INVALID_PATH"},
    {"name": "current text at a missing key", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.missing", "error": "PATH_NOT_FOUND"},
    {"name": "current text through a non-container", "format": "json", "text": "[\"apple\",\"banana\"]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.name", "error": "TYPE_MISMATCH"},
    {"name": "current text past the end of an array", "format": "json", "text": "[{\"type\":\"heading\",\"depth\":1,\"done\":false,\"meta\":null,\"tags\":[\"a\"]},{\"type\":\"paragraph\",\"depth\":2}]", "dataName": "document", "loops": [{"path": "$", "entry": 0}], "operation": "structuredData.currentGetText", "path": "$.tags[1]", "error": "INDEX_OUT_OF_RANGE"}
  ]
}
