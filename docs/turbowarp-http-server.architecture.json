  "cards": [
    {
      "dot": "cyan",
      "title": "主要パス",
      "items": [
        "HTTP: client -> Node/Hono -> dispatch -> Bridge Message -> WS Bridge -> TurboWarp extension.",
        "Assets and community routes stay server-side: /@assets uses auth/limits/cache/ResourceCapability; community uses session, password, upload, OAuth demo, and in-memory state."
      ]
    },
    {
      "dot": "amber",
      "title": "信頼境界と依存",
      "items": [
        "Untrusted public HTTP crosses optional Digest/TLS; /ws is loopback-only and keeps one active extension socket with request timeouts.",
        "Runtime: Node.js 22+, hono, @hono/node-server, ws, node:https/crypto/fs. Tooling: Vite, TurboWarp Vite plugin, TypeScript, Vitest, ESLint."
      ]
    }
  ]
}
