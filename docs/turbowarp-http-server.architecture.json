    "views": [
      {
        "id": "server-path",
        "label": "Server request path",
        "focus": [
          "http-clients",
          "cli-entry",
          "node-server",
          "hono-router",
          "route-dispatch",
          "bridge-message",
          "ws-bridge",
          "tw-runtime"
        ],
        "note": "HTTP requests are accepted by Hono, normalized, and forwarded to one localhost TurboWarp WebSocket peer."
      },
      {
        "id": "resource-path",
        "label": "Resource path",
        "focus": [
          "http-clients",
          "route-dispatch",
          "asset-router",
          "resource-auth",
          "body-limits",
          "cache-metadata",
          "resource-capability"
        ],
        "note": "/@assets requests remain server-side and are mediated by limits, authorization, metadata, and a pluggable capability."
      },
      {
        "id": "extension-path",
        "label": "Extension runtime",
        "focus": [
          "extension-entry",
          "block-defs",
          "ws-client",
          "request-contexts",
          "response-builder",
          "content-builders",
          "scratch-vm"
        ],
        "note": "The unsandboxed extension converts protocol messages into Scratch block state and sends validated responses back."
      },
      {
        "id": "community-path",
        "label": "Community app",
        "focus": [
          "community-router",
          "session-csrf",
          "password-auth",
          "upload-validation",
          "community-storage",
          "oauth-provider"
        ],
        "note": "The learning-only app is optional and keeps demo auth, upload validation, and in-memory state separate from bridge forwarding."
      },
      {
        "id": "build-path",
        "label": "Build and verification",
        "focus": [
          "block-defs",
          "extension-entry",
          "tw-runtime"
        ],
        "note": "Vite, TypeScript, Vitest, ESLint, docs scripts, and manifest generation sit around the runtime graph rather than on the request path."
      }
    ]
  },
