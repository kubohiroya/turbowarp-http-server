{
  "version": 1,
  "name": "turbowarp-message-app",
  "auth": "none",
  "routes": [
    {
      "id": "home",
      "method": "GET",
      "path": "/",
      "auth": "public",
      "actions": [
        {
          "kind": "respond",
          "format": "text",
          "body": {"kind": "literal", "value": "TurboWarp message API"}
        }
      ]
    },
    {
      "id": "create-message",
      "method": "POST",
      "path": "/messages",
      "auth": "public",
      "actions": [
        {
          "kind": "record-create",
          "collection": "messages",
          "data": {"kind": "request", "source": "body"},
          "result": "created"
        },
        {
          "kind": "set-status",
          "status": 201
        },
        {
          "kind": "respond",
          "format": "json",
          "body": {"kind": "result", "name": "created"}
        }
      ]
    },
    {
      "id": "list-messages",
      "method": "GET",
      "path": "/messages",
      "auth": "public",
      "actions": [
        {
          "kind": "record-list",
          "collection": "messages",
          "result": "messages"
        },
        {
          "kind": "respond",
          "format": "json",
          "body": {"kind": "result", "name": "messages"}
        }
      ]
    }
  ]
}
