{
  "name": "@kubohiroya/turbowarp-http-server",
  "version": "0.2.0",
  "description": "A TurboWarp extension for connecting block programs to an HTTP bridge server.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-http-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-http-server.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-http-server/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "http",
    "websocket",
    "vite",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "turbowarp-http-digest": "dist/digest-cli.js",
    "turbowarp-http-server": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "schemas/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "examples:check": "node scripts/check-examples.ts",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "start": "node dist/cli.js",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run examples:check && pnpm run docs:check && pnpm run check:dist && pnpm run pack:check"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.4.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
