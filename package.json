{
  "name": "@kubohiroya/turbowarp-http-server",
  "version": "0.5.0",
  "description": "A TurboWarp extension for connecting block programs to an HTTP bridge server.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-http-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-http-server.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-http-server/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "http",
    "websocket",
    "vite",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "turbowarp-http-digest": "dist/digest-cli.js",
    "turbowarp-http-server": "dist/cli.js"
  },
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "examples/",
    "schemas/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "lint": "eslint src tests scripts/check-target-runtimes.mts vite.config.ts",
    "test": "vitest run",
    "test:conformance": "vitest run tests/conformance",
    "test:conformance:frontend": "vitest run tests/conformance/frontend.test.ts",
    "test:conformance:core": "vitest run tests/conformance/core-runtime.test.ts",
    "test:conformance:target": "vitest run tests/conformance/target.test.ts",
    "test:conformance:target-runtime": "tsx scripts/check-target-runtimes.mts",
    "examples:check": "node scripts/check-examples.ts",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "start": "node dist/cli.js",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run examples:check && pnpm run docs:check && pnpm run check:dist && pnpm run pack:check && pnpm run samples:check",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-named-data": "^0.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-named-data": "^0.7.0",
    "@kubohiroya/turbowarp-structured-data": "0.11.0-rc.1",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "15.30.2",
    "jose": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "4.135.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "gitHead": "a1bf89b8787f9270e591f43512b427ada69f85ef",
  "x-turbowarp-source": {
    "revision": "a1bf89b8787f9270e591f43512b427ada69f85ef",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
